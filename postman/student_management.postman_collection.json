  "item": [
    {
      "name": "00 - Auth",
      "item": [
        {
          "name": "Login Odoo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login success', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.result && json.result.uid).to.be.ok;",
                  "  pm.collectionVariables.set('user_id', json.result.uid);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"params\": {\n    \"db\": \"{{db}}\",\n    \"login\": \"{{login}}\",\n    \"password\": \"{{password}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/web/session/authenticate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "web",
                "session",
                "authenticate"
              ]
            }
          }
        }
      ]
    },
