{
  "info": {
    "name": "Student Management Odoo API",
    "_postman_id": "5ac7f3cb-3d2c-43e8-9ef6-student-management",
    "description": "Test collection for /edmanage-class and /edmanage-student APIs. Run Login first so Postman stores the Odoo session cookie.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8070"
    },
    {
      "key": "db",
      "value": "odoo"
    },
    {
      "key": "login",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "admin"
    },
    {
      "key": "class_id",
      "value": ""
    },
    {
      "key": "class_copy_id",
      "value": ""
    },
    {
      "key": "class_mass_copy_id",
      "value": ""
    },
    {
      "key": "student_id",
      "value": ""
    },
