<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tra_class_list" model="ir.ui.view">
        <field name="name">tra_class.list</field>
        <field name="model">tra_class</field>
        <field name="arch" type="xml">
            <list string="Lop hoc">
                <field name="code"/>
                <field name="name"/>
                <field name="student_count"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_tra_class_form" model="ir.ui.view">
        <field name="name">tra_class.form</field>
        <field name="model">tra_class</field>
        <field name="arch" type="xml">
            <form string="Lop hoc">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Hoc sinh">
                            <field name="student_ids" context="{'default_class_id': id}">
                                <list editable="bottom">
                                    <field name="code"/>
                                    <field name="fullname"/>
                                    <field name="dob"/>
                                    <field name="sex"/>
                                    <field name="email"/>
                                    <field name="username"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tra_class_search" model="ir.ui.view">
        <field name="name">tra_class.search</field>
        <field name="model">tra_class</field>
        <field name="arch" type="xml">
            <search string="Tim lop hoc">
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
            </search>
        </field>
    </record>

    <record id="action_tra_class" model="ir.actions.act_window">
        <field name="name">Lop hoc</field>
        <field name="res_model">tra_class</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tra_class_search"/>
    </record>

    <menuitem id="menu_student_management_root" name="Quan ly sinh vien" sequence="10"/>
    <menuitem id="menu_tra_class" name="Lop hoc" parent="menu_student_management_root" action="action_tra_class" sequence="10"/>
</odoo>
