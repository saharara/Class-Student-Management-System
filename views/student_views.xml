<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tra_student_list" model="ir.ui.view">
        <field name="name">tra_student.list</field>
        <field name="model">tra_student</field>
        <field name="arch" type="xml">
            <list string="Hoc sinh">
                <field name="code"/>
                <field name="fullname"/>
                <field name="dob"/>
                <field name="sex"/>
                <field name="class_id"/>
                <field name="hobbies"/>
                <field name="email"/>
                <field name="username"/>
            </list>
        </field>
    </record>

    <record id="view_tra_student_form" model="ir.ui.view">
        <field name="name">tra_student.form</field>
        <field name="model">tra_student</field>
        <field name="arch" type="xml">
            <form string="Hoc sinh">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="fullname"/>
                            <field name="dob"/>
                            <field name="sex"/>
                            <field name="class_id"/>
                            <field name="hobbies"/>
                        </group>
                        <group>
                            <field name="email"/>
                            <field name="facebook"/>
                            <field name="username"/>
                            <field name="password" password="True"/>
                            <field name="hair_color"/>
                        </group>
                    </group>
                    <group>
                        <field name="homecity"/>
                        <field name="address"/>
                        <field name="description"/>
                    </group>
                    <group string="Anh the">
                        <field name="attachment_filename" invisible="1"/>
                        <field name="attachment" filename="attachment_filename"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tra_student_search" model="ir.ui.view">
        <field name="name">tra_student.search</field>
        <field name="model">tra_student</field>
        <field name="arch" type="xml">
            <search string="Tim hoc sinh">
                <field name="code"/>
                <field name="fullname"/>
                <field name="email"/>
                <field name="username"/>
                <field name="class_id"/>
                <field name="hobbies"/>
            </search>
        </field>
    </record>

    <record id="action_tra_student" model="ir.actions.act_window">
        <field name="name">Hoc sinh</field>
        <field name="res_model">tra_student</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tra_student_search"/>
    </record>

    <menuitem id="menu_tra_student" name="Hoc sinh" parent="menu_student_management_root" action="action_tra_student" sequence="20"/>
</odoo>
