<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tra_hobby_list" model="ir.ui.view">
        <field name="name">tra_hobby.list</field>
        <field name="model">tra_hobby</field>
        <field name="arch" type="xml">
            <list string="Sở thích">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_tra_hobby_form" model="ir.ui.view">
        <field name="name">tra_hobby.form</field>
        <field name="model">tra_hobby</field>
        <field name="arch" type="xml">
            <form string="Sở thích">
                <sheet>
                    <group>
                        <field name="sequence"/>
                        <field name="code"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tra_hobby" model="ir.actions.act_window">
        <field name="name">Sở thích</field>
        <field name="res_model">tra_hobby</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_tra_hobby" name="Sở thích" parent="menu_student_management_root" action="action_tra_hobby" sequence="30"/>
</odoo>
